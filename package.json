{
  "name": "opencommit",
  "version": "3.2.10",
  "description": "Auto-generate impressive commits in 1 second. Killing lame commits with AI 🤯🔫",
  "keywords": [
    "git",
    "chatgpt",
    "gpt",
    "ai",
    "openai",
    "opencommit",
    "aicommit",
    "aicommits",
    "gptcommit",
    "commit"
  ],
  "main": "cli.js",
  "bin": {
    "opencommit": "out/cli.cjs",
    "oco": "out/cli.cjs"
  },
  "repository": {
    "url": "git+https://github.com/di-sukharev/opencommit.git"
  },
  "type": "module",
  "author": "https://github.com/di-sukharev",
  "license": "MIT",
  "files": [
    "out/cli.cjs",
    "out/tiktoken_bg.wasm"
  ],
  "release": {
    "branches": [
      "master"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "watch": "bun run -S build -- --sourcemap --watch",
    "start": "bun run ./out/cli.cjs",
    "dev": "bun run ./src/cli.ts",
    "build": "bunx rimraf out && bun esbuild.config.js",
    "lint": "eslint src --ext ts && tsc --noEmit",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/ini": "^4.1.1",
    "@types/node": "^25.0.9",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "dotenv": "^17.2.3",
    "esbuild": "^0.27.2",
    "eslint": "^9.24.0",
    "prettier": "^3.8.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@azure/openai": "^2.0.0",
    "@clack/prompts": "^0.11.0",
    "@dqbd/tiktoken": "^1.0.22",
    "@octokit/webhooks-schemas": "^7.6.1",
    "@octokit/webhooks-types": "^7.6.1",
    "axios": "^1.13.2",
    "chalk": "^5.6.2",
    "cleye": "^2.2.1",
    "crypto": "^1.0.1",
    "execa": "^9.6.1",
    "ignore": "^7.0.5",
    "ini": "^6.0.0",
    "openai": "^6.16.0",
    "punycode": "^2.3.1",
    "zod": "^4.3.5"
  },
  "overrides": {
    "ajv": "^8.17.1",
    "whatwg-url": "^14.0.0"
  }
}